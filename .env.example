# Yahoo developer app (https://developer.yahoo.com/apps/create/) - Fantasy Sports read permission
YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=
# The number in your league URL: basketball.fantasysports.yahoo.com/nba/<LEAGUE_ID>
# Several leagues: comma-separated (e.g. 248867,312045). The first is the dashboard default.
YAHOO_LEAGUE_ID=
# Must match the Redirect URI on your Yahoo app exactly
YAHOO_REDIRECT_URI=https://localhost:8080
# Optional: enables news/scouting extraction with Claude. Without it, news is still collected and matched to players.
ANTHROPIC_API_KEY=
# Only for an organization-level key not scoped to a workspace (Console > Settings > Workspaces)
ANTHROPIC_WORKSPACE_ID=
# Season string used by NBA stats
NBA_SEASON=2026-27
NBA_PRIOR_SEASON=2025-26
